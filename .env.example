# ==========================================
# Telegram Settings
# ==========================================
# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID канала (например: @history_channel или -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_username

# (Опционально) ID группы обсуждений (-100...).
# Если оставить пустым, бот автоматически определит linked_chat_id канала!
TELEGRAM_DISCUSSION_ID=

# (Опционально) ID темы / топика в супергруппе (message_thread_id)
# Заполняется, если бот отправляет посты в конкретный топик форума
TELEGRAM_TOPIC_ID=

# (Опционально) Telegram ID администратора для получения алертов об ошибках и статусе
ADMIN_TG_ID=783788614

# ==========================================
# VKontakte Settings
# ==========================================
# Сервисный ключ доступа приложения VK (или токен пользователя)
# Получается на dev.vk.com -> Мои приложения -> Создать приложение -> Настройки -> Сервисный ключ доступа
VK_ACCESS_TOKEN=vk1.a.your_service_or_user_token_here

# Домен или короткое имя группы (например irs2027) или числовой ID
VK_GROUP_DOMAIN=irs2027

# ==========================================
# Application Settings
# ==========================================
# Интервал проверки обновлений в секундах (по умолчанию 60 сек)
POLL_INTERVAL=60

# Сколько последних постов синхронизировать при первом запуске (если база пустая)
INITIAL_POSTS_COUNT=5

# Путь к файлу базы данных SQLite
DATABASE_PATH=data/bot.db
