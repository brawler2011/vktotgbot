# ==========================================
# Окружение и Секреты (Secrets & Env)
# ==========================================
.env
.env.*
!.env.example

# SSH ключи и сертификаты (случайно сгенерированные в папке)
*.pem
*.key
*.pub
deploy_key*
id_rsa*
id_ed25519*

# ==========================================
# База данных и локальные данные
# ==========================================
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# ==========================================
# Python артефакты и кэш
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Виртуальные окружения (Virtual Environments)
# ==========================================
venv/
.venv/
env/
.env_*/
ENV/
env.bak/
venv.bak/

# ==========================================
# Логи и временные файлы
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# Настройки редакторов и IDE
# ==========================================
# JetBrains (PyCharm)
.idea/
*.iws
*.iml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Vim / Emacs / Nano
*.swp
*.swo
*~
.#*

# ==========================================
# Системные файлы ОС (macOS, Windows, Linux)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
